# 서버 환경 변수. 값을 채운 사본은 .env 로 두고 저장소에 올리지 않는다.
# 토큰 서명 키: 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
SERVER_SECRET=
# Postgres 접속 주소. 비우면 메모리 저장소(개발용)로 실행
DATABASE_URL=
# 관리형 Postgres 는 보통 SSL 필요. 로컬 Postgres 면 false
DATABASE_SSL=
# 허용할 웹 출처(쉼표로 구분). 비우면 전부 허용. 안드로이드 앱은 출처 검사와 무관
CORS_ORIGINS=
PORT=8787
NODE_ENV=production
