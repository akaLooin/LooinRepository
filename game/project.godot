; Engine configuration file.
config_version=5

[application]

config/name="Talestopia RPG"
config/description="테일즈토피아 RPG — 차원의 도서관 픽셀 액션 RPG (프로토타입)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataDB="*res://src/core/data_db.gd"
GameState="*res://src/core/game_state.gd"
InputRouter="*res://src/input/input_router.gd"
Sfx="*res://src/core/audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.09, 1)
