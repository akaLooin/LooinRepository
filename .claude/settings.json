{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /root/.local/bin/graphify ]; then exec /root/.local/bin/graphify hook-guard search; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /root/.local/bin/graphify ]; then exec /root/.local/bin/graphify hook-guard read; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /root/.local/bin/graphify ]; then exec /root/.local/bin/graphify hook-guard compact; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-stop.sh\""
          }
        ]
      }
    ]
  }
}
