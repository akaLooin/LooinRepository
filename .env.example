# ── 접속 토큰 (앱에 입력할 비밀번호 같은 것. 길고 아무도 모르는 값으로) ──
LOOIN_OWNER_TOKEN=여기에-긴-비밀-토큰

# ── 1순위 두뇌: Claude (Claude Max/Ultra/Team 요금제에 포함된 "월 API 크레딧") ──
# 구독 로그인 자체는 앱에 연결할 수 없어서(약관), 요금제에 연결한 Console 조직의 API 키를 쓴다.
#  1) claude.ai → 설정 → Billing → "API credits" 에서 Console 조직 연결 (요금제 가입 7일 후부터)
#  2) platform.claude.com → API Keys 에서 키 발급
# 이 크레딧은 구독의 주간 사용 한도와 별개다. Max 는 월 $100, 다 쓰면 과금 없이 멈추고 무료 두뇌로 넘어간다.
ANTHROPIC_API_KEY=
# 일의 종류별 모델 (비우면 아래 기본값)
#  FAST: 기억 정리·커뮤니티·질문 난이도 판단·가벼운 대화   CHAT: 평소 대화·아이디어 회의·회의록
#  DEEP: 깊은 고민·하루 한 번의 성찰                       BEST: 앱에서 "최고"를 골랐을 때만
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
CLAUDE_MODEL_BEST=claude-fable-5-2
# 아카엘이 한 달에 쓸 최대 금액(달러). 크레딧 일부를 다른 데 쓰고 싶으면 줄이면 됨 (예: 50 = 절반만)
CLAUDE_MONTHLY_BUDGET_USD=100
# 요금제 결제일(매달 며칠). 크레딧이 이 날 새로 들어온다
CLAUDE_CYCLE_START_DAY=1
# on 이면 한 달에 걸쳐 고르게 씀 (예: 10일째면 예산의 1/3 까지만). off 면 예산까지 먼저 씀
CLAUDE_PACING=on

# ── 무료 두뇌 공급자 키: 하나 이상 넣으면 됨. 여러 개 넣을수록 무료 한도가 합쳐진다 ──
# ※ 무료/무상 제공은 대부분 "입력 내용을 회사의 모델 개선(학습)에 쓰는 것"을 조건으로 한다.

# [최전선 회사 · 공식 무료]
# https://aistudio.google.com/apikey  — Gemini Flash 자동 선택
GEMINI_API_KEY=
# https://console.mistral.ai  — 무료 Experiment 플랜 (데이터 학습 사용 동의 필요). Mistral Large 자동 선택
MISTRAL_API_KEY=
# OpenAI 데이터 공유 프로그램 (platform.openai.com → Data controls → Sharing)
#   - 대상 조직에만 표시되는 무상 토큰(하루 한도). 잔액이 조금 충전돼 있어야 하고, 한도를 넘으면 잔액에서 과금됨
#   - 안전하게: 소액만 충전 + 자동 충전 끄기. 모델은 직접 지정 (지정 안 하면 사용 안 함)
OPENAI_API_KEY=
OPENAI_MODEL=

# [공개 모델 · 무료 등급]
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/settings/keys   (무료 :free 모델만 사용)
OPENROUTER_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=

# 시도 순서 (앞에서부터). 비우면 위 순서.
LOOIN_PROVIDER_ORDER=gemini,openai,mistral,groq,cerebras,nvidia,openrouter

# 모델을 고정하고 싶을 때만 (비우면 각 공급자에서 가장 좋은 공개 모델을 자동 선택)
# GROQ_MODEL=openai/gpt-oss-120b

# 나중에 직접 돌리는 모델(Ollama 등)을 붙일 때
# LOCAL_LLM_URL=http://host.docker.internal:11434/v1

# 세계가 스스로 움직이는 간격(시간). 0 이면 끔.
LOOIN_AUTO_WORLD_HOURS=6
