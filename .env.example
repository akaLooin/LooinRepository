# ── 접속 토큰 (앱에 입력할 비밀번호 같은 것. 길고 아무도 모르는 값으로) ──
LOOIN_OWNER_TOKEN=여기에-긴-비밀-토큰

# ── 무료 두뇌 공급자 키: 하나 이상 넣으면 됨. 여러 개 넣을수록 무료 한도가 합쳐진다 ──
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/settings/keys   (무료 :free 모델만 사용)
OPENROUTER_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://aistudio.google.com/apikey   (Google 공식 무료 등급 — Gemini Flash 자동 선택.
#   주의: 무료 등급 입력은 Google 제품 개선(학습)에 쓰일 수 있음)
GEMINI_API_KEY=

# 시도 순서 (앞에서부터). 비우면 위 순서.
LOOIN_PROVIDER_ORDER=groq,cerebras,nvidia,openrouter,gemini

# 모델을 고정하고 싶을 때만 (비우면 각 공급자에서 가장 좋은 공개 모델을 자동 선택)
# GROQ_MODEL=openai/gpt-oss-120b

# 나중에 직접 돌리는 모델(Ollama 등)을 붙일 때
# LOCAL_LLM_URL=http://host.docker.internal:11434/v1

# 세계가 스스로 움직이는 간격(시간). 0 이면 끔.
LOOIN_AUTO_WORLD_HOURS=6
