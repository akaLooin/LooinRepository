<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 예정 거래 알림(사용자가 설정에서 켤 때만 요청) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager 의 포그라운드 서비스는 쓰지 않는다(알림 작업은 짧은 일반 작업) → Play 포그라운드 서비스 신고 대상에서 제외 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!-- 인터넷: 외화 계좌가 있을 때 최신 환율만 받아 온다(통화 코드만 보냄, 설정에서 끌 수 있음).
         영수증 글자 읽기(ML Kit)는 앱에 포함된 모델로 기기 안에서만 처리한다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LooinApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Looin"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <!-- ML Kit 의 사용 통계 전송 통로를 뺀다(보낼 곳이 없으면 통계는 버려짐). 앱은 환율 외에는 아무것도 보내지 않는다 -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <!-- 영수증 촬영: 카메라 앱에 사진을 쓸 임시 위치를 넘긴다(카메라 권한은 쓰지 않음) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 예정 거래 알림의 "완료" 버튼 -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- 홈 화면 위젯 -->
        <receiver
            android:name=".widget.LooinWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/looin_widget_info" />
        </receiver>
    </application>
</manifest>
