{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    },
    "design": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "design"
      },
      "channel": "design"
    },
    "admin": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "admin"
      },
      "channel": "admin"
    }
  }
}
